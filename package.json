{
  "name": "tubemuse",
  "version": "0.1.0",
  "private": true,
  "description": "TubeMuse — 按意图找片的个人 Chrome 扩展（MV3，本地优先）",
  "type": "module",
  "scripts": {
    "setup": "node scripts/gen-key.mjs",
    "build": "node scripts/build.mjs",
    "build:e2e": "node scripts/build.mjs --e2e",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:install": "playwright install chromium",
    "e2e": "node scripts/build.mjs --e2e && node tests/e2e/run-e2e.mjs && node scripts/build.mjs && node tests/e2e/smoke-prod.mjs",
    "verify": "npm run typecheck && npm run test && npm run e2e"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.2.0",
    "openai": "6.49.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@types/chrome": "0.3.6",
    "@types/node": "20.19.43",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
